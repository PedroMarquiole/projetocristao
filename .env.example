# Variáveis de ambiente do checkout (BuckPay). Cadastre na Vercel: Settings > Environment Variables.
# NUNCA coloque os valores reais neste arquivo nem no GitHub.

GATEWAY_SECRET_KEY=         # token de 40 caracteres da BuckPay (Bearer)
GATEWAY_USER_AGENT=         # valor do User-Agent informado pelo gerente de contas da BuckPay
GATEWAY_WEBHOOK_TOKEN=      # senha para o webhook; invente uma, ex.: 32 letras e números aleatórios
GATEWAY_OFFER_SLUG=         # (opcional) slug da oferta no painel da BuckPay
GATEWAY_API_URL=            # (opcional) só se a BuckPay mudar o endereço da API
